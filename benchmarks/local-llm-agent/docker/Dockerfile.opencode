# Arm 4 agent container: OpenCode (MIT), default config, Mistral API direct
# (OpenAI-compatible provider from models.dev).
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates ripgrep && \
    npm install -g opencode-ai && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.npm

RUN useradd -m -u 1001 agent && mkdir -p /workspace && chown -R agent:agent /workspace
USER agent
WORKDIR /workspace
ENTRYPOINT ["opencode"]
