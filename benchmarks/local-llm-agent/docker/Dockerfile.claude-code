# Arm 1/2 agent container: isolated Claude Code with its own CLAUDE_CONFIG_DIR.
# Derived from the vexa-agent image recipe (services/vexa-agent/Dockerfile) but
# trimmed to the benchmark's needs: Claude Code CLI + a non-root user.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates ripgrep procps && \
    npm install -g @anthropic-ai/claude-code && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.npm

RUN useradd -m -u 1001 agent && mkdir -p /agent/config /workspace && \
    chown -R agent:agent /agent /workspace

USER agent
ENV CLAUDE_CONFIG_DIR=/agent/config \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Mark onboarding as done so headless -p runs don't prompt.
RUN echo '{"hasCompletedOnboarding": true, "theme": "dark"}' > /agent/config/.claude.json

WORKDIR /workspace
ENTRYPOINT ["claude"]
